# public-edge — the ONLY internet-facing surface of the stack (S09-rev).
#
# Exposure strategy (recorded per the S09 deployment spec): reverse-proxy
# ALLOWLIST. Exactly three paths are public:
#
#   POST /signing/callbacks/diia    — Дія posts the signed envelope here
#   GET  /verify/*                  — public envelope verification (token-secret)
#   POST /v1/completions/inline     — Layer C typing path (S15, ADR-0036;
#                                     JWT enforced by the service — the
#                                     edge only caps the request rate)
#
# Everything else — the rest of /v1/*, /signing/sessions, /auth/*,
# health/metrics — returns 404 at the edge and never reaches a service.
# The app keeps its own rate limits (per-IP Redis token bucket 60/min on
# /verify; per-USER dual-window burst 10/s + 30/10s on completions); the
# edge adds a second, stricter per-IP layer (defence in depth). The
# completion endpoint is the easiest accidental-DoS surface in the house
# (it fires on every typing pause), so its edge cap sits BELOW the app
# burst: an unauthenticated flood dies here without spending app CPU.
#
# TLS: terminated here. Local/dev uses the self-signed pair generated by
# infra/edge/gen-dev-cert.sh (certs are gitignored). Production MUST use
# a valid public certificate — Дія will not call self-signed endpoints:
# point PUBLIC_DOMAIN's DNS at this host and mount the Let's Encrypt
# fullchain/privkey at the same /etc/nginx/certs/edge.{crt,key} paths
# (certbot renew hook: `docker compose exec public-edge nginx -s reload`).
# Obtaining the domain + certificate is a business action (todo.md).
#
# ${SIGNING_UPSTREAM} is substituted by the stock nginx docker
# entrypoint (envsubst on /etc/nginx/templates/*.template):
#   compose:      signing-service:8000
#   local proof:  host.docker.internal:8008

limit_req_zone $binary_remote_addr zone=edge_verify:10m     rate=2r/s;
limit_req_zone $binary_remote_addr zone=edge_callback:10m   rate=5r/s;
# 5 r/s + burst 8 per IP: comfortably above debounced typing (~1-2 r/s
# per clinician, and a shared clinic NAT still fits), well below the
# app-layer per-user burst (10/s) — the edge always trips first.
limit_req_zone $binary_remote_addr zone=edge_completion:10m rate=5r/s;
limit_req_status 429;

# Redirect any plain-HTTP probe to TLS.
server {
    listen 80 default_server;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;

    ssl_certificate     /etc/nginx/certs/edge.crt;
    ssl_certificate_key /etc/nginx/certs/edge.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # Nothing is public unless explicitly allowlisted below.
    location / {
        return 404;
    }

    location = /signing/callbacks/diia {
        limit_req zone=edge_callback burst=20 nodelay;
        limit_except POST { deny all; }
        proxy_pass http://${SIGNING_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 5m;   # signed envelopes are small
    }

    location /verify/ {
        limit_req zone=edge_verify burst=10 nodelay;
        limit_except GET { deny all; }
        proxy_pass http://${SIGNING_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /v1/completions/inline {
        limit_req zone=edge_completion burst=8 nodelay;
        limit_except POST { deny all; }
        proxy_pass http://${GENERATION_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 64k;   # a typing prefix, never a document
    }
}
