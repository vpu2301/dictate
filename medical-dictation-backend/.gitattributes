# Force LF line endings everywhere; no CRLF on Windows checkouts.
* text=auto eol=lf

*.py    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
Makefile text eol=lf

# Binary
*.png   binary
*.jpg   binary
*.gz    binary

# Eval-corpus audio via Git LFS. The sprint-07 spec intended this but it was
# never wired (found in the sprint-21 deployment verification); wavs added
# from here on are LFS pointers. Onboarding: `git lfs install` once per clone.
eval/**/*.wav filter=lfs diff=lfs merge=lfs -text
