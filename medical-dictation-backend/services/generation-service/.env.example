# Service-level overrides. Copy to .env.local — never commit .env.local.
ENVIRONMENT=development
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SDK_DISABLED=false

REDIS_URL=redis://localhost:6379/0
DB_AUDIT_WRITER_DSN=postgresql://audit_writer:audit_writer@localhost:5432/medical_dictation

# ── Layer C (ADR-0036) ──────────────────────────────────────────────
MDX_LAYER_C_ENABLED=true
# Empty = all tenants; comma-separated tenant UUIDs to restrict.
MDX_GEN_TENANT_ALLOWLIST=

# llama-server (default) or ollama. Launch the dev backend with e.g.:
#   llama-server -m <gemma3-1b gguf blob> --port 8089 --parallel 2 -c 4096 -ngl 99
MDX_GEN_BACKEND=llamacpp
MDX_GEN_BASE_URL=http://localhost:8089
MDX_GEN_MODEL=gemma3:1b
MDX_GEN_MAX_TOKENS=24
# Production budget is 600 (p95 <= 400 rig-gated, ADR-0036). Dev CPU/Metal
# hosts may raise this so completions actually arrive (M5 measured p50
# ~580-840 ms end-to-end).
MDX_GEN_TIMEOUT_MS=600
MDX_GEN_SLOTS=2
MDX_GEN_RATE_BURST_PER_S=10
MDX_GEN_RATE_PER_10S=30
