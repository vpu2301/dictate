# Service-level overrides. Copy to .env.local — never commit .env.local.
ENVIRONMENT=development
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SDK_DISABLED=false

# Auth (Keycloak via auth-service)
AUTH_ISSUER=http://localhost:8088/realms/medical-dictation
AUTH_JWKS_URL=http://localhost:8088/realms/medical-dictation/protocol/openid-connect/certs
AUTH_AUDIENCE=mdx-api

# DB / Redis
DB_APP_ROLE_DSN=postgresql://app_role:app_role@localhost:5432/medical_dictation
DB_AUDIT_WRITER_DSN=postgresql://audit_writer:audit_writer@localhost:5432/medical_dictation
REDIS_URL=redis://localhost:6379/0

# CORS for the SPA dev origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Tuning
MDX_TRIE_CACHE_TTL=3600
MDX_SUGGEST_DEFAULT_LIMIT=3
MDX_SUGGEST_MAX_LIMIT=10
MDX_PHRASE_MAX_PER_HOUR=100
MDX_TELEMETRY_FLUSH_S=5.0
MDX_TELEMETRY_FLUSH_BATCH=100

# In-process maintenance loops (partition rotation + nightly roll-up).
# Disable when an external scheduler owns these jobs.
MDX_BACKGROUND_JOBS=true
MDX_BACKGROUND_JOBS_INTERVAL_S=86400
