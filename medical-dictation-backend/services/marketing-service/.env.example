# marketing-service — demo booking funnel.
#
# Copy to .env.local for a local run. NEVER commit the real values:
# MDX_MARKETING_SMTP_PASSWORD and MDX_DEMO_IMAP_PASSWORD are the sales
# mailbox credential.

ENVIRONMENT=development
LOG_LEVEL=INFO

DB_APP_ROLE_DSN=postgresql://app_role:app_role@localhost:5432/medical_dictation

# The marketing site's origin — the browser posts the demo form from here.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Outbound mail ────────────────────────────────────────────────────
# Dev: leave as-is and read the mail in Mailpit at http://localhost:8025.
MDX_EMAIL_PROVIDER=smtp
MDX_MARKETING_SMTP_HOST=localhost
MDX_MARKETING_SMTP_PORT=1025
MDX_MARKETING_SMTP_USE_TLS=false
MDX_MARKETING_EMAIL_FROM=sales@klarnote.com
MDX_MARKETING_EMAIL_FROM_NAME=Klarnote
MDX_MARKETING_REPLY_TO=sales@klarnote.com

# Production (Google Workspace):
#   MDX_MARKETING_SMTP_HOST=smtp.gmail.com
#   MDX_MARKETING_SMTP_PORT=587
#   MDX_MARKETING_SMTP_USE_TLS=true
#   MDX_MARKETING_SMTP_USERNAME=sales@klarnote.com
#   MDX_MARKETING_SMTP_PASSWORD=<16-char App Password, NOT the account password>
#
# Google has refused plain account passwords for SMTP since 2024. The
# account needs 2-Step Verification on, then an App Password minted at
# https://myaccount.google.com/apppasswords. Without it every send fails
# with "535 Username and Password not accepted".

# ── Booking watch (inbound) ─────────────────────────────────────────
# Off by default. With it off, the acknowledgement mail still goes out
# but bookings are never detected and no confirmation is sent.
MDX_DEMO_WATCH_ENABLED=false
MDX_DEMO_IMAP_HOST=imap.gmail.com
MDX_DEMO_IMAP_PORT=993
MDX_DEMO_IMAP_USERNAME=sales@klarnote.com
MDX_DEMO_IMAP_PASSWORD=
MDX_DEMO_IMAP_FOLDER=INBOX
MDX_DEMO_IMAP_INTERVAL_S=120
MDX_DEMO_IMAP_LOOKBACK_DAYS=3
# Only invitations whose summary contains this become demo bookings.
MDX_DEMO_SUMMARY_MATCH=demo
# Leave false unless you are certain no other meeting lands on this mailbox.
MDX_DEMO_CONFIRM_UNMATCHED=false

# ── Links in the mail ────────────────────────────────────────────────
MDX_DEMO_BOOKING_URL=https://calendar.app.google/336HQrX67TV9UNJr8
MDX_PUBLIC_BASE_URL=https://klarnote.com
MDX_DEMO_HOST_NAME=Andrii Kovalchuk
MDX_DEMO_MINUTES=40

# ── Abuse control ────────────────────────────────────────────────────
MDX_DEMO_RATE_LIMIT_HOUR=10
# MUST be a long random string outside dev.
MDX_DEMO_IP_HASH_SALT=dev-marketing-salt
