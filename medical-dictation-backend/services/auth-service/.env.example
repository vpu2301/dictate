# auth-service — local overrides. Copy to `.env.local` (gitignored).
#
# Only the password-recovery settings are listed here; everything else
# has a working dev default in config.py. See the runbook at
# docs/runbooks/password-recovery.md.

# ── Feature switch ───────────────────────────────────────────────────
# OFF by default in code. The endpoints 404 until this is true, so a
# deployment with no mail relay does not advertise a reset flow it
# cannot complete.
MDX_PASSWORD_RESET_ENABLED=true

# ── Mail ─────────────────────────────────────────────────────────────
# `mock` captures in memory (and REFUSES to run in production);
# `smtp` talks to Mailpit in dev, Google Workspace in prod.
MDX_EMAIL_PROVIDER=smtp

# Dev: Mailpit, no TLS, no credentials — http://localhost:8025 to read.
MDX_AUTH_SMTP_HOST=localhost
MDX_AUTH_SMTP_PORT=1025
MDX_AUTH_SMTP_USE_TLS=false
MDX_AUTH_SMTP_USERNAME=
MDX_AUTH_SMTP_PASSWORD=

# Production (Google Workspace):
#   MDX_AUTH_SMTP_HOST=smtp.gmail.com
#   MDX_AUTH_SMTP_PORT=587
#   MDX_AUTH_SMTP_USE_TLS=true
#   MDX_AUTH_SMTP_USERNAME=sales@klarnote.com
#   MDX_AUTH_SMTP_PASSWORD=<16-char App Password>
#
# NOT the account password. Google Workspace has refused plain account
# passwords for SMTP since 2024; the account needs 2-Step Verification
# on and an App Password generated for it. The symptom of getting this
# wrong is `535-5.7.8 Username and Password not accepted`.

MDX_AUTH_EMAIL_FROM=sales@klarnote.com
MDX_AUTH_EMAIL_FROM_NAME=Klarnote
MDX_AUTH_EMAIL_REPLY_TO=sales@klarnote.com

# ── Links ────────────────────────────────────────────────────────────
# The origin the SPA is served from. Every mailed link is built from
# this, so a wrong value produces reset mail whose button 404s.
MDX_APP_BASE_URL=http://localhost:5173
MDX_SUPPORT_URL=https://klarnote.com/contact

# ── Lifetimes ────────────────────────────────────────────────────────
# Reset link: 30 minutes (OWASP's useful range is 15–60).
MDX_PASSWORD_RESET_TTL_SECONDS=1800
# Lockdown link: 7 days. It rides in the "your password was changed"
# mail and exists for the case where the change was NOT the account
# holder — who may be asleep, on shift, or away when it lands.
MDX_LOCKDOWN_TOKEN_TTL_SECONDS=604800

# ── Policy ───────────────────────────────────────────────────────────
# Floored at 8 in code (NIST SP 800-63B); 12 for anything guarding PHI.
MDX_PASSWORD_MIN_LENGTH=12

# ── Abuse caps (per hour, fail-OPEN if Redis is down) ────────────────
MDX_PASSWORD_RESET_IP_PER_HOUR=20
MDX_PASSWORD_RESET_EMAIL_PER_HOUR=5

# MUST be set per-deployment. The IPv4 space is small enough to reverse
# an unsalted hash by brute force in seconds.
MDX_PASSWORD_RESET_IP_HASH_SALT=dev-ip-hash-salt-change-in-prod

# ── Outbox worker ────────────────────────────────────────────────────
MDX_BACKGROUND_JOBS=true
MDX_AUTH_MAIL_DELIVERY_INTERVAL_S=5
MDX_AUTH_MAIL_DELIVERY_BATCH=25
MDX_AUTH_MAIL_DELIVERY_MAX_ATTEMPTS=5
MDX_AUTH_MAIL_DELIVERY_BACKOFF_BASE_S=60

# ── Session revocation ───────────────────────────────────────────────
# Password changes push the account onto the denylist as well as calling
# Keycloak's logout. With this off, only Keycloak's half runs and access
# tokens already issued stay valid for their remaining lifetime.
MDX_SESSION_REVOCATION_ENABLED=true
REDIS_URL=redis://localhost:6379/0
