# Template for deploy/secrets/erasure.env (that path is gitignored via
# the global `secrets/` rule — copy this file there and fill in).
#
#   mkdir -p deploy/secrets
#   cp deploy/compose/erasure.env.example deploy/secrets/erasure.env
#
# DB_ERASURE_DSN is the ONLY credential that can DELETE PHI rows
# (role mdx_erasure, migration 0044 + infra/postgres/init.sql). It is
# injected exclusively into the erasure job containers in
# deploy/compose/privacy-ops.yml — never into a request-serving
# service. No interactive human use.
DB_ERASURE_DSN=postgresql://mdx_erasure:mdx_erasure@postgres:5432/medical_dictation
