{
  "components": {
    "schemas": {
      "CreatePhraseRequest": {
        "additionalProperties": false,
        "properties": {
          "language": {
            "enum": [
              "uk",
              "en"
            ],
            "title": "Language",
            "type": "string"
          },
          "phrase": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Phrase",
            "type": "string"
          },
          "section_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section Hint"
          },
          "source": {
            "default": "user",
            "enum": [
              "user",
              "tenant"
            ],
            "title": "Source",
            "type": "string"
          },
          "specialty": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Specialty"
          }
        },
        "required": [
          "phrase",
          "language"
        ],
        "title": "CreatePhraseRequest",
        "type": "object"
      },
      "CreateSnippetRequest": {
        "additionalProperties": false,
        "properties": {
          "cursor_position": {
            "default": 0,
            "minimum": 0.0,
            "title": "Cursor Position",
            "type": "integer"
          },
          "expansion": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Expansion",
            "type": "string"
          },
          "language": {
            "enum": [
              "uk",
              "en"
            ],
            "title": "Language",
            "type": "string"
          },
          "source": {
            "default": "user",
            "enum": [
              "user",
              "tenant"
            ],
            "title": "Source",
            "type": "string"
          },
          "trigger": {
            "description": "Latin slug (DB CHECK ^[a-z][a-z0-9_-]{0,30}$); typed with a leading / at request time.",
            "maxLength": 32,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9_-]{0,30}$",
            "title": "Trigger",
            "type": "string"
          }
        },
        "required": [
          "trigger",
          "expansion",
          "language"
        ],
        "title": "CreateSnippetRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PhraseDTO": {
        "additionalProperties": false,
        "properties": {
          "acceptance_count": {
            "title": "Acceptance Count",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "impression_count": {
            "title": "Impression Count",
            "type": "integer"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "phrase": {
            "title": "Phrase",
            "type": "string"
          },
          "section_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
