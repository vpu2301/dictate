          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "specialty": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Specialty"
          }
        },
        "required": [
          "id",
          "phrase",
          "language",
          "specialty",
          "section_hint",
          "source",
          "impression_count",
          "acceptance_count"
        ],
        "title": "PhraseDTO",
        "type": "object"
      },
      "SnippetDTO": {
        "additionalProperties": false,
        "properties": {
          "cursor_position": {
            "title": "Cursor Position",
            "type": "integer"
          },
          "expansion": {
            "title": "Expansion",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "trigger": {
            "title": "Trigger",
            "type": "string"
          }
        },
        "required": [
          "id",
          "trigger",
          "expansion",
          "cursor_position",
          "language",
          "source"
        ],
        "title": "SnippetDTO",
        "type": "object"
      },
      "SuggestRequest": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional editor context (e.g. {field}). Accepted and forwarded to telemetry only \u2014 sprint 10 does NO context-aware ranking; do not expect behavior from it.",
            "title": "Context"
          },
          "language": {
            "enum": [
              "uk",
              "en"
            ],
            "title": "Language",
            "type": "string"
          },
          "limit": {
            "default": 3,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "prefix": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Prefix",
            "type": "string"
          }
        },
        "required": [
          "prefix",
          "language"
        ],
        "title": "SuggestRequest",
        "type": "object"
      },
      "SuggestResponse": {
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/SuggestionDTO"
            },
            "title": "Suggestions",
            "type": "array"
          }
        },
        "required": [
          "request_id",
          "suggestions"
        ],
        "title": "SuggestResponse",
        "type": "object"
      },
      "SuggestionDTO": {
        "additionalProperties": false,
        "properties": {
          "completion": {
            "title": "Completion",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "cursor_offset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor Offset"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "phrase",
              "snippet"
            ],
            "title": "Kind",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "completion",
          "source",
          "confidence"
        ],
        "title": "SuggestionDTO",
        "type": "object"
      },
      "TelemetryRequest": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "additionalProperties": true,
            "title": "Context",
            "type": "object"
          },
          "event": {
            "enum": [
              "shown_only",
              "accepted",
              "rejected",
              "timeout"
            ],
            "title": "Event",
            "type": "string"
          },
          "phrase_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phrase Id"
          },
          "prefix": {
            "maxLength": 200,
            "title": "Prefix",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "snippet_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snippet Id"
          },
          "source": {
            "default": "autocomplete",
            "enum": [
              "autocomplete",
              "layer_c"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "event",
          "prefix"
        ],
        "title": "TelemetryRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Sprint-10 autocomplete + snippet expansion.",
