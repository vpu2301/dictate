{
  "components": {
    "schemas": {
      "Body_submit_job_asr_jobs_post": {
        "properties": {
          "audio": {
            "contentMediaType": "application/octet-stream",
            "description": "Audio file to transcribe.",
            "title": "Audio",
            "type": "string"
          },
          "encounter_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Encounter Id"
          },
          "language": {
            "pattern": "^(uk|en)$",
            "title": "Language",
            "type": "string"
          },
          "prompt_id": {
            "format": "uuid",
            "title": "Prompt Id",
            "type": "string"
          }
        },
        "required": [
          "audio",
          "prompt_id",
          "language"
        ],
        "title": "Body_submit_job_asr_jobs_post",
        "type": "object"
      },
      "ConfidenceSpanView": {
        "description": "A character range in an enriched segment's ``text`` flagged by the\nNLP confidence stage (low word-probability regions, clinically risky\nnumbers, \u2026).",
        "properties": {
          "end_char": {
            "minimum": 0.0,
            "title": "End Char",
            "type": "integer"
          },
          "level": {
            "title": "Level",
            "type": "string"
          },
          "start_char": {
            "minimum": 0.0,
            "title": "Start Char",
            "type": "integer"
          }
        },
        "required": [
          "start_char",
          "end_char",
          "level"
        ],
        "title": "ConfidenceSpanView",
        "type": "object"
      },
      "EnrichedSegment": {
        "description": "One segment as served by ``GET /asr/jobs/{id}/result``.\n\n``text`` is the NLP post-processed rendering (dictated punctuation\napplied, numbers/dates normalized) when the view's ``nlp_applied``\nis true; otherwise it equals ``raw_text``. ``words`` always carry\nthe raw Whisper timings.",
        "properties": {
          "avg_confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Avg Confidence",
            "type": "number"
          },
          "confidence_spans": {
            "items": {
              "$ref": "#/components/schemas/ConfidenceSpanView"
            },
            "title": "Confidence Spans",
            "type": "array"
          },
          "end_ms": {
            "minimum": 0.0,
            "title": "End Ms",
            "type": "integer"
          },
          "raw_text": {
            "title": "Raw Text",
            "type": "string"
          },
          "start_ms": {
            "minimum": 0.0,
            "title": "Start Ms",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "words": {
            "items": {
              "$ref": "#/components/schemas/WordTiming"
            },
            "title": "Words",
            "type": "array"
          }
        },
        "required": [
          "text",
          "raw_text",
          "start_ms",
          "end_ms",
          "avg_confidence"
        ],
        "title": "EnrichedSegment",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
