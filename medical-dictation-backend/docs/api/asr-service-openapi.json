          },
          "patient_name_en": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Name En"
          },
          "patient_name_uk": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Name Uk"
          },
          "prompt_id": {
            "format": "uuid",
            "title": "Prompt Id",
            "type": "string"
          },
          "queued_at": {
            "format": "date-time",
            "title": "Queued At",
            "type": "string"
          },
          "requester_sub": {
            "format": "uuid",
            "title": "Requester Sub",
