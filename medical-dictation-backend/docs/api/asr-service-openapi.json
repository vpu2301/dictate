      },
      "TranscriptResultView": {
        "description": "Plaintext transcript response for a COMPLETE job (proxy-decrypt).\n\nThe stored artifact stays :class:`TranscriptionOutput` (raw ASR);\nNLP enrichment is applied at read time and degrades gracefully \u2014\n``nlp_applied=False`` means the segments are the raw transcript.",
        "properties": {
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "language": {
            "pattern": "^(uk|en|de)$",
            "title": "Language",
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/TranscriptionMetadata"
          },
          "nlp_applied": {
            "default": false,
            "title": "Nlp Applied",
            "type": "boolean"
          },
          "nlp_pipeline_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nlp Pipeline Version"
          },
          "schema_version": {
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/EnrichedSegment"
            },
            "title": "Segments",
            "type": "array"
          }
        },
        "required": [
          "job_id",
          "language",
          "segments",
          "metadata"
        ],
        "title": "TranscriptResultView",
        "type": "object"
      },
      "TranscriptionJobView": {
        "description": "Public view of a transcription job. Returned by the GET endpoints.",
