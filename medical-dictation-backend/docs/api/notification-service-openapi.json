{
  "components": {
    "schemas": {
      "Category": {
        "description": "The v1 notification categories.\n\nAdding a member here is not enough to make it work: every category\nMUST also have an entry in ``notification_service.domain.catalog``.\nA test enforces the 1:1 mapping, so an un-catalogued category is a\nbuild failure rather than a silent no-op at runtime \u2014 the same\n\"unknown intent is a bug\" contract as nlp-service's operations map.",
        "enum": [
          "report.finalized",
          "report.signed",
          "report.signing_failed",
          "report.amended",
          "report.chain_failure",
          "report.shared_with_you",
          "dictation.completed",
          "transcription.completed",
          "transcription.failed",
          "phi_access.granted",
          "security.mfa_reminder",
          "system.digest"
        ],
        "title": "Category",
        "type": "string"
      },
      "CategoryPreference": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "digest_eligible": {
            "default": false,
            "title": "Digest Eligible",
            "type": "boolean"
          },
          "email_mode": {
            "$ref": "#/components/schemas/EmailMode"
          },
          "in_app_enabled": {
            "title": "In App Enabled",
            "type": "boolean"
          },
          "is_default": {
            "default": false,
            "title": "Is Default",
            "type": "boolean"
          }
        },
        "required": [
          "category",
          "in_app_enabled",
          "email_mode"
        ],
        "title": "CategoryPreference",
        "type": "object"
      },
      "EmailMode": {
        "description": "Per-category email delivery mode.",
        "enum": [
          "immediate",
          "digest",
          "off"
        ],
        "title": "EmailMode",
        "type": "string"
      },
      "FeedPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/NotificationItem"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "unread_count": {
            "title": "Unread Count",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "unread_count"
        ],
        "title": "FeedPage",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NotificationItem": {
        "additionalProperties": false,
        "properties": {
          "body_text": {
            "title": "Body Text",
            "type": "string"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "deep_link": {
            "title": "Deep Link",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "read_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Read At"
          },
          "resource_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Id"
          },
          "resource_type": {
            "title": "Resource Type",
            "type": "string"
          },
          "severity": {
            "title": "Severity",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "category",
          "title",
          "body_text",
          "deep_link",
          "resource_type",
          "resource_id",
          "severity",
          "read_at",
          "created_at"
        ],
        "title": "NotificationItem",
        "type": "object"
      },
      "PreferencesUpdate": {
        "additionalProperties": false,
        "properties": {
          "categories": {
            "items": {
              "$ref": "#/components/schemas/CategoryPreference"
            },
            "title": "Categories",
            "type": "array"
          },
          "digest_hour": {
            "default": 8,
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Digest Hour",
            "type": "integer"
          },
          "quiet_hours": {
            "$ref": "#/components/schemas/QuietHours"
          },
          "timezone": {
            "default": "Europe/Kyiv",
            "title": "Timezone",
            "type": "string"
          }
        },
        "title": "PreferencesUpdate",
        "type": "object"
      },
      "PreferencesView": {
        "additionalProperties": false,
        "properties": {
          "categories": {
            "items": {
              "$ref": "#/components/schemas/CategoryPreference"
            },
            "title": "Categories",
            "type": "array"
          },
          "digest_hour": {
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Digest Hour",
            "type": "integer"
          },
          "quiet_hours": {
            "$ref": "#/components/schemas/QuietHours"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "categories",
          "timezone",
          "quiet_hours",
          "digest_hour"
        ],
        "title": "PreferencesView",
        "type": "object"
      },
      "QuietHours": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "anyOf": [
              {
                "format": "time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "start": {
            "anyOf": [
              {
                "format": "time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          }
        },
        "title": "QuietHours",
        "type": "object"
      },
      "ReadResult": {
        "additionalProperties": false,
        "properties": {
          "unread_count": {
            "title": "Unread Count",
            "type": "integer"
          },
          "updated": {
            "title": "Updated",
            "type": "integer"
          }
        },
        "required": [
          "updated",
          "unread_count"
        ],
        "title": "ReadResult",
        "type": "object"
      },
      "UnreadCount": {
        "additionalProperties": false,
        "properties": {
          "unread_count": {
            "title": "Unread Count",
            "type": "integer"
          }
        },
        "required": [
          "unread_count"
        ],
        "title": "UnreadCount",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Sprint-12 notification fan-out: in-app feed, WebSocket push (medical-notifications.v1), and email.",
    "title": "Notification Service",
    "version": "0.12.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe"
      }
    },
    "/readyz": {
      "get": {
        "description": "Ready only when both dependencies answer.\n\nRedis is not optional here the way it is for a cache-backed service:\nit carries the event stream AND the cross-worker fan-out, so a\nworker that cannot reach it would accept sockets it can never push\nto.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Readyz Readyz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness probe"
      }
    },
    "/v1/notifications": {
      "get": {
        "operationId": "list_notifications_v1_notifications_get",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "unread_only",
            "required": false,
            "schema": {
              "default": false,
              "title": "Unread Only",
              "type": "boolean"
            }
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cursor-paginated notification feed",
        "tags": [
          "notifications"
        ]
      }
    },
    "/v1/notifications/preferences": {
      "get": {
        "operationId": "get_preferences_v1_notifications_preferences_get",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreferencesView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read your notification preferences",
        "tags": [
          "notifications"
        ]
      },
      "put": {
        "operationId": "put_preferences_v1_notifications_preferences_put",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferencesUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreferencesView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Replace your preferences",
        "tags": [
          "notifications"
        ]
      }
    },
    "/v1/notifications/read-all": {
      "post": {
        "operationId": "mark_all_read_v1_notifications_read_all_post",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mark every notification read",
        "tags": [
          "notifications"
        ]
      }
    },
    "/v1/notifications/unread-count": {
      "get": {
        "operationId": "get_unread_count_v1_notifications_unread_count_get",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadCount"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cheap badge count",
        "tags": [
          "notifications"
        ]
      }
    },
    "/v1/notifications/{notification_id}/read": {
      "post": {
        "operationId": "mark_read_v1_notifications__notification_id__read_post",
        "parameters": [
          {
            "in": "path",
            "name": "notification_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Notification Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mark one notification read (idempotent)",
        "tags": [
          "notifications"
        ]
      }
    }
  }
}
